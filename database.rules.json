{
  "rules": {
    // People who answer website chats: { "<Firebase Auth uid>": true }.
    // Set only in the Firebase console or with the Admin SDK; no client can read or write it.
    "chatAgents": {
      ".read": false,
      ".write": false
    },

    "chats": {
      // Listing every chat: chat agents only.
      ".read": "auth != null && root.child('chatAgents').child(auth.uid).val() === true",

      // A session's key is the visitor's anonymous Firebase Auth uid.
      "$sessionId": {
        // The visitor reads only their own session.
        ".read": "auth != null && auth.uid === $sessionId",
        // Agents may write anything in a session, including deleting it.
        ".write": "auth != null && root.child('chatAgents').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['visitorName', 'visitorEmail', 'status'])",

        // What the visitor writes when the chat goes to a person (PATCH, field by field).
        "visitorName": {
          ".write": "auth != null && auth.uid === $sessionId",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "visitorEmail": {
          ".write": "auth != null && auth.uid === $sessionId",
          ".validate": "newData.isString() && newData.val().length <= 254 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)"
        },
        "page": {
          ".write": "auth != null && auth.uid === $sessionId",
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "startedAt": {
          ".write": "auth != null && auth.uid === $sessionId",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "escalatedFrom": {
          ".write": "auth != null && auth.uid === $sessionId",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "escalateReason": {
          ".write": "auth != null && auth.uid === $sessionId",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        // The visitor can (re)open the chat; only an agent closes it.
        "status": {
          ".write": "auth != null && auth.uid === $sessionId && newData.val() === 'open'",
          ".validate": "newData.val() === 'open' || newData.val() === 'closed'"
        },
        // The visitor can flag the chat for the agent; only an agent clears it.
        "unreadByAgent": {
          ".write": "auth != null && auth.uid === $sessionId && newData.val() === true",
          ".validate": "newData.isBoolean()"
        },
        "unreadByVisitor": {
          ".validate": "newData.isBoolean()"
        },
        "lastMessage": {
          ".write": "auth != null && auth.uid === $sessionId && (!newData.child('sender').exists() || newData.child('sender').val() === 'visitor')",
          ".validate": "newData.hasChildren(['text', 'timestamp'])",
          "text": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "timestamp": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "sender": { ".validate": "newData.val() === 'visitor' || newData.val() === 'agent'" },
          "$other": { ".validate": false }
        },
        "messages": {
          "$messageId": {
            // The visitor adds messages (never edits or deletes them): their own, plus the
            // AI replies copied in when the chat goes to a person.
            ".write": "auth != null && auth.uid === $sessionId && !data.exists() && (newData.child('sender').val() === 'visitor' || (newData.child('sender').val() === 'agent' && newData.child('isAiMessage').val() === true))",
            ".validate": "newData.hasChildren(['text', 'sender', 'timestamp'])",
            "text": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "sender": { ".validate": "newData.val() === 'visitor' || newData.val() === 'agent'" },
            "senderName": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "timestamp": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "isAiMessage": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
