{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "condo-super-app",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "CLAUDE.md",
      "STRIPE_SETUP.md",
      "functions/**",
      "SET_FIREBASE_CONFIG.sh",
      "*.md",
      "database.rules.json",
      "database-tests/**"
    ],
    "rewrites": [
      {
        "source": "/welcome/**",
        "function": {
          "functionId": "welcomePage",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
